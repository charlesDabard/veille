<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Gabarit launchd de la boucle quotidienne. __HOME__ se remplace par votre $HOME, voir extras/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.veille-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.claude/skills/veille/extras/automatisation/loop-cron.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>13</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.config/veille/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.config/veille/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
